import Aegis.MinInsertions.Code.Funs

/-!
# Specifications of `Aegis.MinInsertions.min_insertions`

LeetCode problem `minimum-insertions-to-balance-a-parentheses-string`. Each `spec_<n>` theorem states one property of the function.
-/

open Aeneas Aeneas.Std Result

namespace AegisSpec.MinInsertions

def LPAREN : Std.U8 := 40#u8

def RPAREN : Std.U8 := 41#u8

def IsParenList (l : List Std.U8) : Prop :=
  ∀ b ∈ l, b = LPAREN ∨ b = RPAREN

def IsParenSlice (s : Slice Std.U8) : Prop :=
  IsParenList s.val

inductive Balanced : List Std.U8 → Prop where
  | nil : Balanced []
  | cons {u v : List Std.U8} :
      Balanced u → Balanced v →
      Balanced (LPAREN :: (u ++ RPAREN :: RPAREN :: v))

def countOpen (l : List Std.U8) : ℕ :=
  (l.filter (fun b => b = LPAREN)).length

def countClose (l : List Std.U8) : ℕ :=
  (l.filter (fun b => b = RPAREN)).length

def numOpen (s : Slice Std.U8) : ℕ :=
  countOpen s.val

def numClose (s : Slice Std.U8) : ℕ :=
  countClose s.val

def padStep (st : List Std.U8 × Bool) (b : Std.U8) : List Std.U8 × Bool :=
  if b = RPAREN then
    (b :: st.1, !st.2)
  else
    ((if st.2 then b :: RPAREN :: st.1 else b :: st.1), false)

def padRuns (l : List Std.U8) : List Std.U8 :=
  let st := l.foldl padStep ([], false)
  if st.2 then st.1.reverse ++ [RPAREN] else st.1.reverse

def prefixMaxExcess (l : List Std.U8) : ℤ :=
  (List.range (l.length + 1)).foldr
    (fun i acc => max ((countClose (l.take i) : ℤ) - 2 * (countOpen (l.take i) : ℤ)) acc) 0

def excessBound (l : List Std.U8) : ℤ :=
  max 0 (prefixMaxExcess l)

def paddedD (s : Slice Std.U8) : ℤ :=
  excessBound (padRuns s.val)

def plainD (s : Slice Std.U8) : ℤ :=
  excessBound s.val

def ceilHalf (D : ℤ) : ℤ :=
  (D + 1) / 2

def PrefixExcessNonpos (l : List Std.U8) : Prop :=
  ∀ i : ℕ, i ≤ l.length →
    (countClose (l.take i) : ℤ) ≤ 2 * (countOpen (l.take i) : ℤ)

/-- The function returns a result r and r is the smallest non-negative integer k such that there exists a string t over {'(', ')'} with len(t) = n + k, s is a subsequence of t, and t is balanced. A string t over {'(', ')'} is balanced if it is generated by the grammar B ::= ε | '(' B '))' B, where ε is the empty string and concatenation is string concatenation.
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, and for every i with 0 <= i < n, s[i] is either 40 (the ASCII code for '(') or 41 (the ASCII code for ')'). -/
theorem spec_1 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s) :
    ∃ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r ∧
      0 ≤ r.val ∧
      (∃ t : List Std.U8,
        Balanced t ∧ s.val.Sublist t ∧ (t.length : ℤ) = (n : ℤ) + r.val) ∧
      (∀ k : ℕ,
        (∃ t : List Std.U8, Balanced t ∧ s.val.Sublist t ∧ t.length = n + k) →
        r.val ≤ (k : ℤ)) := by
  sorry

theorem spec_1_neg :
    ¬ (∀ (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s), ∃ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r ∧
      0 ≤ r.val ∧
      (∃ t : List Std.U8,
        Balanced t ∧ s.val.Sublist t ∧ (t.length : ℤ) = (n : ℤ) + r.val) ∧
      (∀ k : ℕ,
        (∃ t : List Std.U8, Balanced t ∧ s.val.Sublist t ∧ t.length = n + k) →
        r.val ≤ (k : ℤ))) := by
  sorry

/-- The function returns a result r and does not fail (no panic, no arithmetic overflow).
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, and for every i with 0 <= i < n, s[i] is either 40 or 41. -/
theorem spec_2 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s) :
    ∃ r : Std.I64, Aegis.MinInsertions.min_insertions s = ok r := by
