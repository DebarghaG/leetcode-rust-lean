  else
    let p ←
      min_wasted_space_loop0 packages n (alloc.vec.Vec.new Std.I64) 0#usize
    let p1 ← sort_vec p
    let pref ← alloc.vec.Vec.push (alloc.vec.Vec.new Std.I64) 0#i64
    let pref1 ← min_wasted_space_loop1 n p1 pref 0#i64 0#usize
    let m := Slice.len boxes
    let best ← min_wasted_space_loop2 boxes n p1 pref1 m (-1)#i64 0#usize
    if best < 0#i64
    then ok (-1)#i64
    else best % 1000000007#i64

end Aegis.MinWastedSpace
