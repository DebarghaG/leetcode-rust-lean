/-- Whenever the function returns a result r on (source, target, allowedSwaps) and a result r' on (source', target', allowedSwaps), we have r = r'.
  Preconditions: Let n = len(source). Assume len(source) = len(target) = n, 1 <= n <= 100000; for every i with 0 <= i < n, 1 <= source[i] <= 100000 and 1 <= target[i] <= 100000; len(allowedSwaps) <= 100000; for every k with 0 <= k < len(allowedSwaps), len(allowedSwaps[k]) = 2, and if a = allowedSwaps[k][0] and b = allowedSwaps[k][1], then 0 <= a < n, 0 <= b < n, a != b. Let f be an injective mapping from the set of values appearing in source or target to integers with 1 <= f(v) <= 100000. Define source'[i] = f(source[i]) and target'[i] = f(target[i]) for all i with 0 <= i < n. -/
theorem spec_12 (source target source' target' : Slice I64)
    (sw : Slice (alloc.vec.Vec I64)) (f : Int → Int)
    (hwf : WellFormed source target sw)
    (hinj : ∀ v w,
      v ∈ valueSet (contents source) (contents target) source.val.length →
      w ∈ valueSet (contents source) (contents target) source.val.length →
      f v = f w → v = w)
    (hrange : ∀ v, v ∈ valueSet (contents source) (contents target) source.val.length →
      1 ≤ f v ∧ f v ≤ 100000)
    (hlenS : source'.val.length = source.val.length)
    (hlenT : target'.val.length = source.val.length)
    (hS : ∀ i, i < source.val.length →
      entry (contents source') i = f (entry (contents source) i))
    (hT : ∀ i, i < source.val.length →
      entry (contents target') i = f (entry (contents target) i)) :
    ∀ r r', minimum_hamming_distance source target sw = ok r →
      minimum_hamming_distance source' target' sw = ok r' → r.val = r'.val := by
  sorry

