  let m_i ← lift (UScalar.hcast .I64 m)
  let ordered1 ← assign_bikes_loop5 workers bikes n m 0#usize pos ordered m_i
  let (used_w, ans) ←
    assign_bikes_loop6 n 0#usize (alloc.vec.Vec.new Bool) (alloc.vec.Vec.new
      Std.I64)
  let used_b ← assign_bikes_loop7 m (alloc.vec.Vec.new Bool) 0#usize
  assign_bikes_loop8 total 0#usize ordered1 m_i used_w used_b ans

end Aegis.AssignBikes
