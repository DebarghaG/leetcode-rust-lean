        num_enclaves_loop1 grid m n seen n_i (alloc.vec.Vec.new Std.I64)
          0#usize
      let (seen2, stack1) ←
        num_enclaves_loop2 grid m n seen1 n_i stack 0#usize
      let seen3 ← num_enclaves_loop3 grid m n seen2 n_i stack1 0#usize
      num_enclaves_loop4 grid m n seen3 0#i64 0#usize

end Aegis.NumEnclaves
