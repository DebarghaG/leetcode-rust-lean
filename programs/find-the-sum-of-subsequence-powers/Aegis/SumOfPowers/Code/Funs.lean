  (k : Std.I64) (a : alloc.vec.Vec Std.I64) (raw : alloc.vec.Vec Std.I64)
  (m : Std.Usize) (ans : Std.I64) (prev : Std.I64) (idx : Std.Usize) :
  Result Std.I64
  := do
  loop
    (fun (ans1, prev1, idx1) => sum_of_powers_loop4.body k a raw m ans1 prev1
      idx1)
    (ans, prev, idx)

/-- [sum_of_powers::sum_of_powers]:
    Source: 'sum_of_powers/src/lib.rs', lines 65:0-139:1
    Visibility: public -/
def sum_of_powers (nums : Slice Std.I64) (k : Std.I64) : Result Std.I64 := do
  if k < 2#i64
  then ok 0#i64
  else
    let n := Slice.len nums
    let a ← sum_of_powers_loop0 nums n (alloc.vec.Vec.new Std.I64) 0#usize
    let a1 ← sum_of_powers_loop1 n a 1#usize
    let raw ← sum_of_powers_loop2 n a1 (alloc.vec.Vec.new Std.I64) 0#usize
    let m := alloc.vec.Vec.len raw
    if m = 0#usize
    then ok 0#i64
    else
      let raw1 ← sum_of_powers_loop3 raw m 1#usize
      sum_of_powers_loop4 k a1 raw1 m 0#i64 0#i64 0#usize

end Aegis.SumOfPowers
