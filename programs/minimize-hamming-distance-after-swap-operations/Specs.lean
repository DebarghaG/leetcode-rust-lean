import Aegis.MinimumHammingDistance.Code.Funs

/-!
# Specifications of `Aegis.MinimumHammingDistance.minimum_hamming_distance`

LeetCode problem `minimize-hamming-distance-after-swap-operations`. Each `spec_<n>` theorem states one property of the function.
-/

open Aeneas Aeneas.Std Result

namespace AegisSpec.MinimumHammingDistance

open Aegis.MinimumHammingDistance
open Classical
open scoped Classical

noncomputable section

def contents (s : Slice I64) : List Int := s.val.map (fun x => x.val)

def entry (l : List Int) (i : Nat) : Int := l.getD i 0

def valueSet (src tgt : List Int) (n : Nat) : Finset Int :=
  ((Finset.range n).image (fun i => entry src i)) ∪
    ((Finset.range n).image (fun i => entry tgt i))

def swapEnds (sw : Slice (alloc.vec.Vec I64)) (k : Nat) : Option (Int × Int) :=
  (sw.val[k]?).bind fun v =>
    match v.val with
    | [a, b] => some (a.val, b.val)
    | _ => none

def Step (sw : Slice (alloc.vec.Vec I64)) (i j : Nat) : Prop :=
  ∃ k a b, swapEnds sw k = some (a, b) ∧ 0 ≤ a ∧ 0 ≤ b ∧
    ((i = a.toNat ∧ j = b.toNat) ∨ (i = b.toNat ∧ j = a.toNat))

def SwapEquiv (sw : Slice (alloc.vec.Vec I64)) (i j : Nat) : Prop :=
  Relation.EqvGen (Step sw) i j

def IsClassRep (sw : Slice (alloc.vec.Vec I64)) (n i : Nat) : Prop :=
  i < n ∧ ∀ j, j < n → SwapEquiv sw i j → i ≤ j

def repSet (sw : Slice (alloc.vec.Vec I64)) (n : Nat) : Finset Nat :=
  (Finset.range n).filter (fun i => IsClassRep sw n i)

def classCount (l : List Int) (sw : Slice (alloc.vec.Vec I64)) (n i : Nat) (v : Int) : Int :=
  (((Finset.range n).filter (fun j => SwapEquiv sw i j ∧ entry l j = v)).card : Int)

def specValue (src tgt : List Int) (sw : Slice (alloc.vec.Vec I64)) (n : Nat) : Int :=
  ∑ i ∈ repSet sw n,
    ∑ v ∈ valueSet src tgt n,
      max 0 (classCount src sw n i v - classCount tgt sw n i v)

def hammingCount (src tgt : List Int) (n : Nat) : Nat :=
  ((Finset.range n).filter (fun i => entry src i ≠ entry tgt i)).card

def permMismatch (src tgt : List Int) (n : Nat) (π : Equiv.Perm (Fin n)) : Nat :=
  (Finset.univ.filter (fun i : Fin n => entry src (π i).val ≠ entry tgt i.val)).card

def WellFormed (source target : Slice I64) (sw : Slice (alloc.vec.Vec I64)) : Prop :=
  let n := source.val.length
  1 ≤ n ∧ n ≤ 100000 ∧
    target.val.length = n ∧
    (∀ i, i < n → 1 ≤ entry (contents source) i ∧ entry (contents source) i ≤ 100000) ∧
    (∀ i, i < n → 1 ≤ entry (contents target) i ∧ entry (contents target) i ≤ 100000) ∧
    sw.val.length ≤ 100000 ∧
    (∀ k, k < sw.val.length →
      ∃ a b, swapEnds sw k = some (a, b) ∧ 0 ≤ a ∧ a < (n : Int) ∧ 0 ≤ b ∧
        b < (n : Int) ∧ a ≠ b)

theorem length_val_eq_len {α : Type} (s : Slice α) : s.val.length = Slice.len s := by
  simp [Slice.val, Slice.len]

theorem length_contents (s : Slice I64) : (contents s).length = s.val.length := by
  simp [contents]

/-- Let ~ be the equivalence relation on {0,...,n-1} generated by the undirected edges {allowedSwaps[k][0], allowedSwaps[k][1]} for 0 <= k < len(allowedSwaps). For an equivalence class C of ~ and an integer v, let cS(C,v) = #{i : i in C and source[i] = v} and cT(C,v) = #{i : i in C and target[i] = v}. For every input satisfying the preconditions, the function returns a result r and r = sum over all equivalence classes C of ~ and all integers v of max(0, cS(C,v) - cT(C,v)). Only finitely many v have cS(C,v) or cT(C,v) nonzero, so the inner sum is finite.
  Preconditions: Let n = len(source). Assume len(source) = len(target) = n, 1 <= n <= 100000; for every i with 0 <= i < n, 1 <= source[i] <= 100000 and 1 <= target[i] <= 100000; len(allowedSwaps) <= 100000; for every k with 0 <= k < len(allowedSwaps), len(allowedSwaps[k]) = 2, and if a = allowedSwaps[k][0] and b = allowedSwaps[k][1], then 0 <= a < n, 0 <= b < n, a != b. -/
theorem spec_1 (source target : Slice I64) (sw : Slice (alloc.vec.Vec I64))
    (hwf : WellFormed source target sw) :
    ∃ r, minimum_hamming_distance source target sw = ok r ∧
      r.val = specValue (contents source) (contents target) sw source.val.length := by
  sorry

theorem spec_1_neg :
    ¬ (∀ (source target : Slice I64) (sw : Slice (alloc.vec.Vec I64))
    (hwf : WellFormed source target sw), ∃ r, minimum_hamming_distance source target sw = ok r ∧
      r.val = specValue (contents source) (contents target) sw source.val.length) := by
  sorry

/-- Let H = #{i : 0 <= i < n and source[i] != target[i]}. Whenever the function returns a result r, we have r <= H.
  Preconditions: Let n = len(source). Assume len(source) = len(target) = n, 1 <= n <= 100000; for every i with 0 <= i < n, 1 <= source[i] <= 100000 and 1 <= target[i] <= 100000; len(allowedSwaps) <= 100000; for every k with 0 <= k < len(allowedSwaps), len(allowedSwaps[k]) = 2, and if a = allowedSwaps[k][0] and b = allowedSwaps[k][1], then 0 <= a < n, 0 <= b < n, a != b. -/
