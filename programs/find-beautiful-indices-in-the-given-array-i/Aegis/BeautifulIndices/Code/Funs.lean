      let occ_b ←
        beautiful_indices_loop1 s b lb (alloc.vec.Vec.new Std.Usize) last1
          0#usize
      beautiful_indices_loop2 k occ_a occ_b (alloc.vec.Vec.new Std.I64) 0#usize
        0#usize
    else
      beautiful_indices_loop3 k occ_a (alloc.vec.Vec.new Std.Usize)
        (alloc.vec.Vec.new Std.I64) 0#usize 0#usize
  else
    if lb <= n
    then
      let last ← n - lb
      let occ_b ←
        beautiful_indices_loop4 s b lb (alloc.vec.Vec.new Std.Usize) last
          0#usize
      beautiful_indices_loop5 k (alloc.vec.Vec.new Std.Usize) occ_b
        (alloc.vec.Vec.new Std.I64) 0#usize 0#usize
    else
