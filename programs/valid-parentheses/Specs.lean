import Aegis.IsValid.Code.Funs

/-!
# Specifications of `Aegis.IsValid.is_valid`

LeetCode problem `valid-parentheses`. Each `spec_<n>` theorem states one property of the function.
-/

open Aeneas Aeneas.Std Result

  namespace AegisSpec.IsValid

  def openingBracket (b : Std.U8) : Prop :=
    b = 40#u8 ∨ b = 91#u8 ∨ b = 123#u8

  def closingBracket (b : Std.U8) : Prop :=
    b = 41#u8 ∨ b = 93#u8 ∨ b = 125#u8

  def bracketByte (b : Std.U8) : Prop :=
    openingBracket b ∨ closingBracket b

  def complementByte (b : Std.U8) : Std.U8 :=
    if b = 40#u8 then 41#u8
    else if b = 41#u8 then 40#u8
    else if b = 91#u8 then 93#u8
    else if b = 93#u8 then 91#u8
    else if b = 123#u8 then 125#u8
    else if b = 125#u8 then 123#u8
    else b

  def countByte (b : Std.U8) (l : List Std.U8) : Nat :=
    l.count b

  def countOpening (l : List Std.U8) : Nat :=
    countByte 40#u8 l + countByte 91#u8 l + countByte 123#u8 l

  def countClosing (l : List Std.U8) : Nat :=
    countByte 41#u8 l + countByte 93#u8 l + countByte 125#u8 l

  inductive ValidBrackets : List Std.U8 → Prop where

    | nil : ValidBrackets []

    | concat {u v : List Std.U8} : ValidBrackets u → ValidBrackets v →
        ValidBrackets (u ++ v)

    | paren {v : List Std.U8} : ValidBrackets v →
        ValidBrackets (40#u8 :: (v ++ [41#u8]))

    | bracket {v : List Std.U8} : ValidBrackets v →
        ValidBrackets (91#u8 :: (v ++ [93#u8]))

    | brace {v : List Std.U8} : ValidBrackets v →
        ValidBrackets (123#u8 :: (v ++ [125#u8]))

  /-- Whenever the function returns a result r, r = true if and only if s is a valid bracket sequence, meaning s belongs to the language generated by V ::= ε | V V | '(' V ')' | '[' V ']' | '{' V '}'; equivalently, the bracket occurrences in s can be paired so that each pair consists of an opening bracket followed later by its matching closing bracket of the same type, every occurrence belongs to exactly one pair, and no two pairs cross. In particular, r = false exactly when s is not such a valid sequence.
    Preconditions: 1 <= len(s) <= 10000, and for every i with 0 <= i < len(s), the byte s[i] is one of 40, 41, 91, 93, 123, 125 (that is, one of the ASCII characters '(', ')', '[', ']', '{', '}'). -/
  theorem spec_1 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → (r = true ↔ ValidBrackets s.val) := by
    sorry

  theorem spec_1_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → (r = true ↔ ValidBrackets s.val)) := by
    sorry

  /-- The function returns a result r for every s satisfying the preconditions; it does not fail, panic, overflow, or access out of bounds.
    Preconditions: 1 <= len(s) <= 10000, and for every i with 0 <= i < len(s), the byte s[i] is one of 40, 41, 91, 93, 123, 125. -/
  theorem spec_2 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∃ r : Bool, Aegis.IsValid.is_valid s = ok r := by
    sorry

  theorem spec_2_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∃ r : Bool, Aegis.IsValid.is_valid s = ok r) := by
    sorry

  /-- Whenever the function returns a result r, if len(s) is odd, then r = false.
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_3 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → s.val.length % 2 = 1 → r = false := by
    sorry

  theorem spec_3_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → s.val.length % 2 = 1 → r = false) := by
    sorry

  /-- Whenever the function returns a result r, if r = true, then s[0] is an opening bracket (byte 40 '(', 91 '[', or 123 '{') and s[len(s)-1] is a closing bracket (byte 41 ')', 93 ']', or 125 '}').
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_4 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true →
        openingBracket (s.val.get ⟨0, by omega⟩) ∧
        closingBracket (s.val.get ⟨s.val.length - 1, by omega⟩) := by
    sorry

  theorem spec_4_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true →
          openingBracket (s.val.get ⟨0, by omega⟩) ∧
          closingBracket (s.val.get ⟨s.val.length - 1, by omega⟩)) := by
    sorry

  /-- Whenever the function returns a result r, if r = true, then for every k with 0 <= k <= len(s), among the prefix bytes s[0], ..., s[k-1], the number of opening brackets is at least the number of closing brackets. Here opening brackets are '(', '[', '{' and closing brackets are ')', ']', '}'.
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_5 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true →
        ∀ k : Nat, k ≤ s.val.length →
          countClosing (s.val.take k) ≤ countOpening (s.val.take k) := by
    sorry

  theorem spec_5_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true →
          ∀ k : Nat, k ≤ s.val.length →
            countClosing (s.val.take k) ≤ countOpening (s.val.take k)) := by
    sorry

  /-- Whenever the function returns a result r, if r = true, then the number of occurrences of '(' in s equals the number of occurrences of ')', the number of occurrences of '[' equals the number of occurrences of ']', and the number of occurrences of '{' equals the number of occurrences of '}'.
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_6 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true →
        countByte 40#u8 s.val = countByte 41#u8 s.val ∧
        countByte 91#u8 s.val = countByte 93#u8 s.val ∧
        countByte 123#u8 s.val = countByte 125#u8 s.val := by
    sorry

  theorem spec_6_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true →
          countByte 40#u8 s.val = countByte 41#u8 s.val ∧
          countByte 91#u8 s.val = countByte 93#u8 s.val ∧
          countByte 123#u8 s.val = countByte 125#u8 s.val) := by
    sorry

  /-- Whenever the function returns a result r, if r = true, then for every index i with 0 <= i < len(s) such that s[i] is a closing bracket, let o be the opening bracket of the corresponding type (')' corresponds to '(', ']' corresponds to '[', '}' corresponds to '{'); in the prefix s[0], ..., s[i-1], the number of occurrences of o is strictly greater than the number of occurrences of s[i].
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_7 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true →
        ∀ (i : Nat) (hi : i < s.val.length), closingBracket (s.val[i]) →
          countByte (complementByte (s.val[i])) (s.val.take i) >
            countByte (s.val[i]) (s.val.take i) := by
    sorry

  theorem spec_7_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true →
          ∀ (i : Nat) (hi : i < s.val.length), closingBracket (s.val[i]) →
            countByte (complementByte (s.val[i])) (s.val.take i) >
              countByte (s.val[i]) (s.val.take i)) := by
    sorry

  /-- For every s satisfying the preconditions, let t be the byte array of the same length defined by t[i] = complement(s[len(s)-1-i]) for every i with 0 <= i < len(s), where complement maps '(' to ')', ')' to '(', '[' to ']', ']' to '[', '{' to '}', and '}' to '{'. Then whenever the function returns a result r on s and a result r' on t, r = r'.
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_8 (s t : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b)
      (hlen_t : t.val.length = s.val.length)
      (hrev : ∀ (i : Nat) (hi : i < t.val.length),
        t.val[i] = complementByte (s.val.get ⟨s.val.length - 1 - i, by omega⟩)) :
      ∀ r r' : Bool, Aegis.IsValid.is_valid s = ok r → Aegis.IsValid.is_valid t = ok r' →
        r = r' := by
    sorry

  theorem spec_8_neg :
      ¬ (∀ (s t : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b)
        (hlen_t : t.val.length = s.val.length)
        (hrev : ∀ (i : Nat) (hi : i < t.val.length),
          t.val[i] = complementByte (s.val.get ⟨s.val.length - 1 - i, by omega⟩)), ∀ r r' : Bool, Aegis.IsValid.is_valid s = ok r → Aegis.IsValid.is_valid t = ok r' →
          r = r') := by
    sorry

  /-- Let s and t be nonempty byte arrays consisting only of allowed bracket bytes with len(s) + len(t) <= 10000. If s and t are both valid bracket sequences (each belongs to the language generated by V ::= ε | V V | '(' V ')' | '[' V ']' | '{' V '}'), then whenever the function returns a result r on the concatenation s ++ t (the byte array of length len(s)+len(t) whose first len(s) bytes are s and whose remaining bytes are t), r = true.
    Preconditions: The function is evaluated on the concatenation s ++ t, where s and t are nonempty byte arrays consisting only of allowed bracket bytes and len(s) + len(t) <= 10000. -/
  theorem spec_9 (s t st : Slice Std.U8)
      (hlen_s_pos : 1 ≤ s.val.length) (hlen_t_pos : 1 ≤ t.val.length)
      (hbytes_s : ∀ b ∈ s.val, bracketByte b)
      (hbytes_t : ∀ b ∈ t.val, bracketByte b)
      (hlen_sum : s.val.length + t.val.length ≤ 10000)
      (hvalid_s : ValidBrackets s.val) (hvalid_t : ValidBrackets t.val)
      (hst : st.val = s.val ++ t.val) :
      ∀ r : Bool, Aegis.IsValid.is_valid st = ok r → r = true := by
    sorry

  theorem spec_9_neg :
      ¬ (∀ (s t st : Slice Std.U8)
        (hlen_s_pos : 1 ≤ s.val.length) (hlen_t_pos : 1 ≤ t.val.length)
        (hbytes_s : ∀ b ∈ s.val, bracketByte b)
        (hbytes_t : ∀ b ∈ t.val, bracketByte b)
        (hlen_sum : s.val.length + t.val.length ≤ 10000)
        (hvalid_s : ValidBrackets s.val) (hvalid_t : ValidBrackets t.val)
        (hst : st.val = s.val ++ t.val), ∀ r : Bool, Aegis.IsValid.is_valid st = ok r → r = true) := by
    sorry

  /-- If there exist a valid bracket sequence t (possibly empty) and a matching opening-closing pair (a, b) equal to ('(', ')') or ('[', ']') or ('{', '}') such that s is the concatenation a ++ t ++ b, then whenever the function returns a result r on s, r = true.
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_10 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b)
      (hwitness : ∃ (t : List Std.U8) (a b : Std.U8),
        ValidBrackets t ∧
        ((a = 40#u8 ∧ b = 41#u8) ∨ (a = 91#u8 ∧ b = 93#u8) ∨
          (a = 123#u8 ∧ b = 125#u8)) ∧
        s.val = a :: (t ++ [b])) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true := by
    sorry

  theorem spec_10_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b)
        (hwitness : ∃ (t : List Std.U8) (a b : Std.U8),
          ValidBrackets t ∧
          ((a = 40#u8 ∧ b = 41#u8) ∨ (a = 91#u8 ∧ b = 93#u8) ∨
            (a = 123#u8 ∧ b = 125#u8)) ∧
          s.val = a :: (t ++ [b])), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r → r = true) := by
    sorry

  /-- Whenever the function returns a result r, if every byte of s is an opening bracket (that is, each s[i] is one of '(', '[', '{'), then r = false.
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_11 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r →
        (∀ b ∈ s.val, openingBracket b) → r = false := by
    sorry

  theorem spec_11_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r →
          (∀ b ∈ s.val, openingBracket b) → r = false) := by
    sorry

  /-- Whenever the function returns a result r, if every byte of s is a closing bracket (that is, each s[i] is one of ')', ']', '}'), then r = false.
    Preconditions: 1 <= len(s) <= 10000, and every byte of s is one of '(', ')', '[', ']', '{', '}'. -/
  theorem spec_12 (s : Slice Std.U8)
      (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
      (hbytes : ∀ b ∈ s.val, bracketByte b) :
      ∀ r : Bool, Aegis.IsValid.is_valid s = ok r →
        (∀ b ∈ s.val, closingBracket b) → r = false := by
    sorry

  theorem spec_12_neg :
      ¬ (∀ (s : Slice Std.U8)
        (hlen_pos : 1 ≤ s.val.length) (hlen_max : s.val.length ≤ 10000)
        (hbytes : ∀ b ∈ s.val, bracketByte b), ∀ r : Bool, Aegis.IsValid.is_valid s = ok r →
          (∀ b ∈ s.val, closingBracket b) → r = false) := by
    sorry

  end AegisSpec.IsValid
