  (grid : Slice (alloc.vec.Vec Std.I64)) (hits : Slice (alloc.vec.Vec Std.I64))
  :
  Result (alloc.vec.Vec Std.I64)
  := do
  let m := Slice.len grid
  let v ← Slice.index_usize grid 0#usize
  let n := alloc.vec.Vec.len v
  let total ← m * n
  let active ← hit_bricks_loop0 grid m n (alloc.vec.Vec.new Std.I64) 0#usize
  let active1 ← hit_bricks_loop1 grid hits n active 0#usize
  let (parent, size) ←
    hit_bricks_loop2 total (alloc.vec.Vec.new Std.I64) (alloc.vec.Vec.new
      Std.I64) 0#usize
  let (parent1, size1) ←
    hit_bricks_loop3 m n total active1 0#usize parent size
  let ans ← hit_bricks_loop4 hits (alloc.vec.Vec.new Std.I64) 0#usize
  let idx := Slice.len hits
  hit_bricks_loop5 grid hits m n total active1 parent1 size1 ans idx

end Aegis.HitBricks
