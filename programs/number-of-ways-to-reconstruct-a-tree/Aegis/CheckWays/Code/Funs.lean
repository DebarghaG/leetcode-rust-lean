    let degree ← check_ways_loop3 n 0#usize (alloc.vec.Vec.new Std.I64)
    let (bits1, degree1) ←
      check_ways_loop4 pairs idx_of1 0#usize words bits degree
    let nodes ← check_ways_loop5 n 0#usize (alloc.vec.Vec.new Std.I64)
    let nodes1 ← check_ways_loop6 n 0#usize degree1 nodes
    let n_i ← lift (UScalar.hcast .I64 n)
    let i1 ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.I64)
        nodes1 0#usize
    let root ← lift (IScalar.hcast .Usize i1)
    let i2 ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.I64)
        degree1 root
    let i3 ← n_i - 1#i64
    let valid ← if i2 != i3
                  then ok false
                  else ok true
    let (ans, valid1) ←
      check_ways_loop7 n words bits1 degree1 nodes1 n_i 1#i64 valid 0#usize
    if valid1
    then ok ans
    else ok 0#i64

end Aegis.CheckWays
