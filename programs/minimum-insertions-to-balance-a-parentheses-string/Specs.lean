    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n)
    (hparen : ∀ b ∈ s.val, b = RPAREN), ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r →
