    "id": 1,
    "theorem": "AegisSpec.NumberOfWays.spec_1",
    "negation": "AegisSpec.NumberOfWays.spec_1_neg",
    "main": true,
    "category": "functional",
    "statement": "The function returns a result r such that 0 <= r < 10^9 + 7 and r ≡ C(n) (mod 10^9 + 7), where C(n) = P(n) + P(n-4) + P(n-8), and for any integer m, P(m) is defined as: P(m) = 0 if m < 0, and otherwise P(m) = |{(a,b,c) ∈ ℕ³ : a + 2b + 6c = m}|. (Here ℕ denotes the non-negative integers.)",
    "preconditions": "1 <= n <= 10^5, where n is the i64 parameter."
  },
  {
    "id": 2,
    "theorem": "AegisSpec.NumberOfWays.spec_2",
    "negation": "AegisSpec.NumberOfWays.spec_2_neg",
    "main": false,
    "category": "no_failure",
    "statement": "For every n satisfying the precondition, the function returns a result r (i.e., it does not fail, panic, or overflow).",
    "preconditions": "1 <= n <= 10^5."
  },
  {
    "id": 3,
