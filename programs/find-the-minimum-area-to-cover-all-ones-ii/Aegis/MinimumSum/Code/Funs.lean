def minimum_sum (grid : Slice (alloc.vec.Vec Std.I64)) : Result Std.I64 := do
  let n := Slice.len grid
  if n = 0#usize
  then ok 0#i64
  else
    let v ← Slice.index_usize grid 0#usize
    let m := alloc.vec.Vec.len v
    if m = 0#usize
    then ok 0#i64
    else
      let ans ← minimum_sum_loop0 grid n m 1000000000#usize 1#usize
      let ans1 ← minimum_sum_loop1 grid n m ans 1#usize
      let ans2 ← minimum_sum_loop2 grid n m ans1 1#usize
      let ans3 ← minimum_sum_loop3 grid n m ans2 1#usize
      ok (UScalar.hcast .I64 ans3)

