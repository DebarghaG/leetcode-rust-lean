/-- [max_tastiness::max_tastiness]:
    Source: 'max_tastiness/src/lib.rs', lines 1:0-103:1
    Visibility: public -/
def max_tastiness
  (price : Slice Std.I64) (tastiness : Slice Std.I64) (maxAmount : Std.I64)
  (maxCoupons : Std.I64) :
  Result Std.I64
  := do
  if maxAmount < 0#i64
  then ok 0#i64
  else
    if maxCoupons < 0#i64
    then ok 0#i64
    else
      let amount_limit ← lift (IScalar.hcast .Usize maxAmount)
      let coupon_limit ← lift (IScalar.hcast .Usize maxCoupons)
      let cols ← amount_limit + 1#usize
      let n := Slice.len price
      let i := Slice.len tastiness
      let n1 ← if i < n
                 then ok (Slice.len tastiness)
                 else ok n
      if n1 = 0#usize
      then ok 0#i64
      else
        let (dp, c) ←
          max_tastiness_loop0 coupon_limit cols (alloc.vec.Vec.new
            (alloc.vec.Vec Std.I64)) 0#usize
        let dp1 ←
          max_tastiness_loop1 price tastiness amount_limit coupon_limit cols n1
            dp c 0#usize
        max_tastiness_loop2 coupon_limit cols dp1 0#usize 0#i64

