  let sorted_deg1 ← sort_i64_vec sorted_deg
  let keys1 ← sort_i64_vec keys
  let m := alloc.vec.Vec.len keys1
  let i ← n - 1#i64
  let i1 ← n * i
  let total_pairs ← i1 / 2#i64
  count_pairs_loop3 n queries n_us deg1 sorted_deg1 keys1 m total_pairs
    (alloc.vec.Vec.new Std.I64) 0#usize

end Aegis.CountPairs
