/-- Whenever the function returns a result r, r = 0 if and only if s is balanced (i.e., s is generated by the grammar B ::= ε | '(' B '))' B).
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, and for every i with 0 <= i < n, s[i] is either 40 or 41. -/
theorem spec_4 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s) :
    ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r → (r.val = 0 ↔ Balanced s.val) := by
