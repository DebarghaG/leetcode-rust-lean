  := do
  let n := Slice.len nums
  let n_i ← lift (UScalar.hcast .I64 n)
  let i ← n_i - 1#i64
  let i1 ← n_i * i
  let total_pairs ← i1 / 2#i64
  let max_orig ← Slice.index_usize nums 0#usize
  let max_orig1 ← gcd_values_loop0 nums n max_orig 1#usize
  if total_pairs <= 20000#i64
  then
    let pairs ← gcd_values_loop1 nums n (alloc.vec.Vec.new Std.I64) 0#usize
    let pairs1 ← sort_i64 pairs
    gcd_values_loop2 queries total_pairs max_orig1 pairs1 (alloc.vec.Vec.new
      Std.I64) 0#usize
  else
    let g ← Slice.index_usize nums 0#usize
