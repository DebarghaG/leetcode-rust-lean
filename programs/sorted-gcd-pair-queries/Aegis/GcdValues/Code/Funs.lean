    let freq1 ← gcd_values_loop4 nums n g1 freq 0#usize
    let i3 ← m + 1#usize
    let exact ← zeros_i64 i3
    let exact1 ← gcd_values_loop5 m freq1 exact m
    let exact2 ← gcd_values_loop6 m exact1 0#i64 1#usize
