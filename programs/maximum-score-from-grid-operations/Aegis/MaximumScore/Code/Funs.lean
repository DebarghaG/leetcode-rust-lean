def maximum_score (grid : Slice (alloc.vec.Vec Std.I64)) : Result Std.I64 := do
  let n := Slice.len grid
  if n = 0#usize
  then ok 0#i64
  else
    let m ← n + 1#usize
    let pref ← maximum_score_loop0 grid n (alloc.vec.Vec.new Std.I64) 0#usize
    let total ← m * m
    let dp ← maximum_score_loop1 total (alloc.vec.Vec.new Std.I64) 0#usize
    let dp1 ← maximum_score_loop2 m dp 0#usize
    let dp2 ← maximum_score_loop3 n m pref dp1 0#usize
    let i ← n - 1#usize
    let base_last ← i * m
    maximum_score_loop4 m pref dp2 base_last 0#i64 0#usize

end Aegis.MaximumScore
