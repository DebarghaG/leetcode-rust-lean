/-- Let ~ be the equivalence relation on {0,...,n-1} generated by the undirected edges from allowedSwaps, and for each equivalence class C and integer v let cS(C,v) = #{i : i in C and source[i] = v} and cT(C,v) = #{i : i in C and target[i] = v}. Whenever the function returns a result r, we have r = 0 if and only if for every equivalence class C of ~ and every integer v, cS(C,v) = cT(C,v).
  Preconditions: Let n = len(source). Assume len(source) = len(target) = n, 1 <= n <= 100000; for every i with 0 <= i < n, 1 <= source[i] <= 100000 and 1 <= target[i] <= 100000; len(allowedSwaps) <= 100000; for every k with 0 <= k < len(allowedSwaps), len(allowedSwaps[k]) = 2, and if a = allowedSwaps[k][0] and b = allowedSwaps[k][1], then 0 <= a < n, 0 <= b < n, a != b. -/
theorem spec_3 (source target : Slice I64) (sw : Slice (alloc.vec.Vec I64))
    (hwf : WellFormed source target sw) :
    ∀ r, minimum_hamming_distance source target sw = ok r →
      (r.val = 0 ↔
        ∀ i, IsClassRep sw source.val.length i →
