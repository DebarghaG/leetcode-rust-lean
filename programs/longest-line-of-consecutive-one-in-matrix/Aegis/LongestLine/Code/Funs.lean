    Source: 'longest_line/src/lib.rs', lines 1:0-135:1
    Visibility: public -/
def longest_line (mat : Slice (alloc.vec.Vec Std.I64)) : Result Std.I64 := do
  let m := Slice.len mat
  if m = 0#usize
  then ok 0#i64
  else
    let v ← Slice.index_usize mat 0#usize
    let n := alloc.vec.Vec.len v
    if n = 0#usize
    then ok 0#i64
    else
      let best ←
        longest_line_loop0 { start := 0#usize, «end» := m } mat n 0#i64
      let best1 ←
        longest_line_loop1 { start := 0#usize, «end» := n } mat m best
      let best2 ←
        longest_line_loop2 { start := 0#usize, «end» := n } mat m n best1
      let best3 ←
        longest_line_loop3 { start := 1#usize, «end» := m } mat m n best2
      let best4 ←
        longest_line_loop4 { start := 0#usize, «end» := n } mat m best3
      longest_line_loop5 { start := 1#usize, «end» := m } mat m n best4

