      let i2 ← n - 1#usize
      let target ← i1 + i2
      let dist1 := index_mut_back 1#i64
      minimum_visited_cells_loop3 grid m n dist1 row_stride col_stride row_next
        col_next queue target 0#usize

end Aegis.MinimumVisitedCells
