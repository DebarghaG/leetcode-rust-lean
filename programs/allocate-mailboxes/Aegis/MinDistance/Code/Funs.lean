def min_distance (houses : Slice Std.I64) (k : Std.I64) : Result Std.I64 := do
  let n := Slice.len houses
  if n = 0#usize
  then ok 0#i64
  else
    let n_i ← lift (UScalar.hcast .I64 n)
    if k >= n_i
    then ok 0#i64
    else
      let kk ← lift (IScalar.hcast .Usize k)
      let arr ←
        min_distance_loop0 houses n (alloc.vec.Vec.new Std.I64) 0#usize
      let arr1 ← min_distance_loop1 n arr 0#usize
      let cost ←
        min_distance_loop2 n 0#usize (alloc.vec.Vec.new (alloc.vec.Vec
          Std.I64))
      let cost1 ← min_distance_loop3 n arr1 0#usize cost
      let dp ←
        min_distance_loop4 n kk (alloc.vec.Vec.new (alloc.vec.Vec Std.I64))
          0#usize
      let (v, index_mut_back) ←
        alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice
          (alloc.vec.Vec Std.I64)) dp 0#usize
      let (_, index_mut_back1) ←
        alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice Std.I64)
          v 0#usize
      let v1 := index_mut_back1 0#i64
      let dp1 := index_mut_back v1
      let dp2 ← min_distance_loop5 n kk cost1 dp1 1#usize
      let v2 ←
        alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
          (alloc.vec.Vec Std.I64)) dp2 kk
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.I64) v2 n

