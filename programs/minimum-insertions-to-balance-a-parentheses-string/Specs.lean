/-- Let L be the number of '(' in s and R the number of ')' in s. Form s' from s by inserting one extra ')' immediately after each maximal contiguous block of ')' in s whose length is odd (if such a block ends at the end of s, append the extra ')' at the end). For 0 <= i <= |s'|, let L'_i and R'_i be the numbers of '(' and ')' in the prefix s'[0..i). Define D = max(0, max_{0 <= i <= |s'|} (R'_i - 2*L'_i)). Then whenever the function returns a result r, r = 2*L - R + 3*ceil(D/2), where ceil(D/2) = (D + 1) / 2 using integer division.
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, and for every i with 0 <= i < n, s[i] is either 40 (the ASCII code for '(') or 41 (the ASCII code for ')'). -/
theorem spec_5 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s) :
    ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r →
      r.val = 2 * (numOpen s : ℤ) - (numClose s : ℤ) + 3 * ceilHalf (paddedD s) := by
  sorry

theorem spec_5_neg :
    ¬ (∀ (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s), ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r →
      r.val = 2 * (numOpen s : ℤ) - (numClose s : ℤ) + 3 * ceilHalf (paddedD s)) := by
  sorry

/-- Let L = number of '(' in s and R = number of ')' in s. Whenever the function returns a result r, r >= max(0, 2*L - R).
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, and for every i with 0 <= i < n, s[i] is either 40 or 41. -/
theorem spec_6 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s) :
    ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r →
      max 0 (2 * (numOpen s : ℤ) - (numClose s : ℤ)) ≤ r.val := by
  sorry

theorem spec_6_neg :
    ¬ (∀ (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s), ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r →
      max 0 (2 * (numOpen s : ℤ) - (numClose s : ℤ)) ≤ r.val) := by
  sorry

/-- Let L_i and R_i be the numbers of '(' and ')' in the prefix s[0..i) for 0 <= i <= n. Define D = max(0, max_{0 <= i <= n} (R_i - 2*L_i)). Whenever the function returns a result r, r >= ceil(D/2), where ceil(D/2) = (D + 1) / 2 using integer division.
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, and for every i with 0 <= i < n, s[i] is either 40 or 41. -/
theorem spec_7 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s) :
    ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r → ceilHalf (plainD s) ≤ r.val := by
  sorry

theorem spec_7_neg :
    ¬ (∀ (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s), ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r → ceilHalf (plainD s) ≤ r.val) := by
