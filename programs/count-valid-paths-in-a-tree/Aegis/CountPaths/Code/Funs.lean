        alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice Bool)
          is_prime 0#usize
      ok (index_mut_back false)
    else ok is_prime
  let is_prime2 ←
    if n_usize >= 1#usize
    then
      do
      let (_, index_mut_back) ←
        alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice Bool)
          is_prime1 1#usize
      ok (index_mut_back false)
    else ok is_prime1
  let is_prime3 ← count_paths_loop1 n_usize is_prime2 2#usize
  let adj ←
    count_paths_loop2 n_usize 0#usize (alloc.vec.Vec.new (alloc.vec.Vec
      Std.I64))
  let adj1 ← count_paths_loop3 edges 0#usize adj
  let comp_id ← count_paths_loop4 n_usize 0#usize (alloc.vec.Vec.new Std.I64)
  let visited ← count_paths_loop5 n_usize 0#usize (alloc.vec.Vec.new Bool)
  let (comp_id1, comp_sizes) ←
    count_paths_loop6 n_usize is_prime3 adj1 comp_id (alloc.vec.Vec.new
      Std.I64) visited 1#usize
  count_paths_loop7 n_usize is_prime3 adj1 comp_id1 comp_sizes 0#i64 1#usize

end Aegis.CountPaths
