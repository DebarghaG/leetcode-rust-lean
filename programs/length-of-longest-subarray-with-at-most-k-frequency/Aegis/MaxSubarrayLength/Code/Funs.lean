  then ok 0#i64
  else
    let sorted ← sorted_copy nums
    let unique ←
      max_subarray_length_loop0 n sorted (alloc.vec.Vec.new Std.I64) 0#usize
    let m := alloc.vec.Vec.len unique
    let freq ←
      max_subarray_length_loop1 0#usize m (alloc.vec.Vec.new Std.I64)
    max_subarray_length_loop2 nums k n unique freq 0#usize 0#usize 0#i64 0#i64

end Aegis.MaxSubarrayLength
