theorem spec_2_neg :
    ¬ (∀ (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s), ∃ r : Std.I64, Aegis.MinInsertions.min_insertions s = ok r) := by
  sorry

