/-- [maximum_set_size::maximum_set_size]:
    Source: 'maximum_set_size/src/lib.rs', lines 92:0-139:1
    Visibility: public -/
def maximum_set_size
  (nums1 : Slice Std.I64) (nums2 : Slice Std.I64) : Result Std.I64 := do
  let n_usize := Slice.len nums1
  let n ← lift (UScalar.hcast .I64 n_usize)
  let i ← n_usize / 2#usize
  let half ← lift (UScalar.hcast .I64 i)
  let a ← sort_copy nums1
  let b ← sort_copy nums2
  let s := alloc.vec.Vec.deref a
  let d1 ← count_distinct_sorted s
  let s1 := alloc.vec.Vec.deref b
  let d2 ← count_distinct_sorted s1
  let all ← maximum_set_size_loop0 nums1 (alloc.vec.Vec.new Std.I64) 0#usize
  let all1 ← maximum_set_size_loop1 nums2 all 0#usize
  let all_sorted ← sort_vec all1
  let s2 := alloc.vec.Vec.deref all_sorted
  let d_union ← count_distinct_sorted s2
  let take1 ← if d1 > half
                then ok half
                else ok d1
  let take2 ← if d2 > half
                then ok half
                else ok d2
  let ans ← take1 + take2
  let ans1 ← if ans > n
               then ok n
               else ok ans
  if ans1 > d_union
  then ok d_union
  else ok ans1

