  else
    let (v, total) ←
      minimum_removal_loop0 beans n (alloc.vec.Vec.new Std.I64) 0#i64 0#usize
    let temp ← minimum_removal_loop1 n 0#usize (alloc.vec.Vec.new Std.I64)
    let (v1, temp1, from_v) ← minimum_removal_loop2 n v temp 1#usize true
    if from_v
    then minimum_removal_loop3 n v1 total 0#usize total
    else minimum_removal_loop4 n total 0#usize temp1 total

end Aegis.MinimumRemoval
