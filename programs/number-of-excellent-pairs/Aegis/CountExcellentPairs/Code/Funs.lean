  let vals1 ← count_excellent_pairs_loop2 n vals temp 1#usize
  let freq ← count_excellent_pairs_loop3 (alloc.vec.Vec.new Std.I64) 0#usize
  let freq1 ← count_excellent_pairs_loop4 n vals1 freq 0#usize
  count_excellent_pairs_loop5 k freq1 0#i64 0#usize

end Aegis.CountExcellentPairs
