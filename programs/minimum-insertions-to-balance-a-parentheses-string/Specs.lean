/-- Let L and R be the total numbers of '(' and ')' in s. Form s' from s by inserting one extra ')' immediately after each maximal contiguous block of ')' in s whose length is odd. For 0 <= i <= |s'|, let L'_i and R'_i be the numbers of '(' and ')' in the prefix s'[0..i), and define D = max(0, max_{0 <= i <= |s'|} (R'_i - 2*L'_i)). Whenever the function returns a result r, the minimum number of inserted '(' needed is ceil(D/2) and the minimum number of inserted ')' needed is 2*L - R + 2*ceil(D/2), where ceil(D/2) = (D + 1) / 2 using integer division; moreover r is the sum of these two quantities.
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, and for every i with 0 <= i < n, s[i] is either 40 or 41. -/
theorem spec_12 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s) :
    ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r →
      r.val = ceilHalf (paddedD s) +
        (2 * (numOpen s : ℤ) - (numClose s : ℤ) + 2 * ceilHalf (paddedD s)) := by
  sorry

theorem spec_12_neg :
    ¬ (∀ (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s), ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r →
      r.val = ceilHalf (paddedD s) +
        (2 * (numOpen s : ℤ) - (numClose s : ℤ) + 2 * ceilHalf (paddedD s))) := by
  sorry

/-- Let L and R be the total numbers of '(' and ')' in s. Whenever the function returns a result r, r = 2*L - R.
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, and for every i with 0 <= i < n, s[i] is either 40 or 41. Let s' be obtained from s by inserting one extra ')' immediately after each maximal contiguous block of ')' in s whose length is odd. For 0 <= i <= |s'|, let L'_i and R'_i be the numbers of '(' and ')' in the prefix s'[0..i). Assume that for every i with 0 <= i <= |s'|, R'_i <= 2*L'_i. -/
theorem spec_13 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n) (hparen : IsParenSlice s)
    (hcond : PrefixExcessNonpos (padRuns s.val)) :
    ∀ r : Std.I64,
      Aegis.MinInsertions.min_insertions s = ok r →
      r.val = 2 * (numOpen s : ℤ) - (numClose s : ℤ) := by
  sorry

