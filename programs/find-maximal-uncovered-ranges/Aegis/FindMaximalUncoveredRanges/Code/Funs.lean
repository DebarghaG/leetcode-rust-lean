    let i ← n - 1#i64
    let row1 ← alloc.vec.Vec.push row i
    alloc.vec.Vec.push (alloc.vec.Vec.new (alloc.vec.Vec Std.I64)) row1
  else
    let (starts, ends) ←
      find_maximal_uncovered_ranges_loop0 ranges m (alloc.vec.Vec.new Std.I64)
        (alloc.vec.Vec.new Std.I64) 0#usize
    let sz := alloc.vec.Vec.len starts
    let (temp_s, temp_e) ←
      find_maximal_uncovered_ranges_loop1 sz (alloc.vec.Vec.new Std.I64)
        (alloc.vec.Vec.new Std.I64) 0#usize
    let (starts1, ends1) ←
      find_maximal_uncovered_ranges_loop2 starts ends sz temp_s temp_e 1#usize
    let (out, cur) ←
      find_maximal_uncovered_ranges_loop3 (alloc.vec.Vec.new (alloc.vec.Vec
        Std.I64)) starts1 ends1 sz 0#i64 0#usize
    let i ← n - 1#i64
    if cur <= i
    then
      let row ← alloc.vec.Vec.push (alloc.vec.Vec.new Std.I64) cur
      let row1 ← alloc.vec.Vec.push row i
      alloc.vec.Vec.push out row1
    else ok out

end Aegis.FindMaximalUncoveredRanges
