  (s1 : Slice Std.U8) (n_usize : Std.Usize)
  (trans : alloc.vec.Vec (alloc.vec.Vec Std.I64)) (state : Std.Usize)
  (pos : Std.Usize) :
  Result Std.I64
  := do
  loop
    (fun (state1, pos1) => find_good_strings_loop3.body s1 n_usize trans state1
      pos1)
    (state, pos)

/-- [find_good_strings::find_good_strings]:
    Source: 'find_good_strings/src/lib.rs', lines 81:0-157:1
    Visibility: public -/
def find_good_strings
  (n : Std.I64) (s1 : Slice Std.U8) (s2 : Slice Std.U8) (evil : Slice Std.U8) :
  Result Std.I64
  := do
  let m := Slice.len evil
  let n_usize ← lift (IScalar.hcast .Usize n)
  let pi ← find_good_strings_loop0 m (alloc.vec.Vec.new Std.Usize) 0#usize
  let pi1 ← find_good_strings_loop1 evil m pi 1#usize 0#usize
  let trans ←
    find_good_strings_loop2 evil m pi1 (alloc.vec.Vec.new (alloc.vec.Vec
      Std.I64)) 0#usize
  let s := alloc.vec.Vec.deref trans
  let hi ← count_leq s2 s m n_usize
  let s3 := alloc.vec.Vec.deref trans
  let lo ← count_leq s1 s3 m n_usize
  let good_s1 ← find_good_strings_loop3 s1 n_usize trans 0#usize 0#usize
  let i ← hi - lo
  let ans ← i % MOD
  let ans1 ← if ans < 0#i64
               then ans + MOD
               else ok ans
  let i1 ← ans1 + good_s1
  i1 % MOD

end Aegis.FindGoodStrings
