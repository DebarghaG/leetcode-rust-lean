[
  {
    "id": 1,
    "theorem": "AegisSpec.CountArrangement.spec_1",
    "negation": "AegisSpec.CountArrangement.spec_1_neg",
    "main": true,
    "category": "functional",
    "statement": "The function returns a result r, and r is the number of permutations perm of the integers 1,2,...,n such that perm is a sequence of length n, indexed from 1 to n, whose entries are exactly 1,2,...,n each once, and for every i with 1 <= i <= n, either perm[i] is divisible by i or i is divisible by perm[i]. Here divisibility means exact integer divisibility.",
    "preconditions": "n is an i64 with 1 <= n <= 15."
  },
  {
    "id": 2,
    "theorem": "AegisSpec.CountArrangement.spec_2",
    "negation": "AegisSpec.CountArrangement.spec_2_neg",
    "main": false,
    "category": "no_failure",
    "statement": "The function returns a result r rather than failing (no overflow, panic, or out-of-bounds condition occurs).",
    "preconditions": "1 <= n <= 15."
  },
  {
    "id": 3,
    "theorem": "AegisSpec.CountArrangement.spec_3",
    "negation": "AegisSpec.CountArrangement.spec_3_neg",
    "main": false,
    "category": "bounds",
    "statement": "Whenever the function returns a result r, r >= 1.",
    "preconditions": "1 <= n <= 15."
  },
  {
    "id": 4,
    "theorem": "AegisSpec.CountArrangement.spec_4",
    "negation": "AegisSpec.CountArrangement.spec_4_neg",
    "main": false,
    "category": "bounds",
    "statement": "Whenever the function returns a result r, r <= n!, where n! denotes the product 1*2*...*n.",
    "preconditions": "1 <= n <= 15."
  },
  {
    "id": 5,
    "theorem": "AegisSpec.CountArrangement.spec_5",
    "negation": "AegisSpec.CountArrangement.spec_5_neg",
    "main": false,
    "category": "bounds",
    "statement": "Whenever the function returns a result r, r <= d(n) * (n-1)!, where d(n) is the number of positive divisors of n and (n-1)! denotes the factorial of n-1 with 0! = 1.",
    "preconditions": "1 <= n <= 15."
  },
  {
    "id": 6,
    "theorem": "AegisSpec.CountArrangement.spec_6",
    "negation": "AegisSpec.CountArrangement.spec_6_neg",
    "main": false,
    "category": "relational",
    "statement": "If count_arrangement n returns r_n and count_arrangement m returns r_m, then r_n <= r_m.",
    "preconditions": "n and m are i64 values with 1 <= n <= m <= 15."
  },
  {
