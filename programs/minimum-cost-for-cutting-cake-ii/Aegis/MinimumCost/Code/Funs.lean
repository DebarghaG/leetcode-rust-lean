  let want_h ← m - 1#i64
  let want_h1 ← if want_h < 0#i64
                  then ok 0#i64
                  else ok want_h
  let want_v ← n - 1#i64
  let want_v1 ← if want_v < 0#i64
                  then ok 0#i64
                  else ok want_v
  let cnt_h := alloc.vec.Vec.len h1
  let i := alloc.vec.Vec.len h1
  let i1 ← lift (UScalar.hcast .I64 i)
  let cnt_h1 ←
    if want_h1 < i1
    then ok (IScalar.hcast .Usize want_h1)
    else ok cnt_h
  let cnt_v := alloc.vec.Vec.len v1
  let i2 := alloc.vec.Vec.len v1
  let i3 ← lift (UScalar.hcast .I64 i2)
  let cnt_v1 ←
    if want_v1 < i3
    then ok (IScalar.hcast .Usize want_v1)
    else ok cnt_v
  let i4 := alloc.vec.Vec.len h1
  let start_h ← i4 - cnt_h1
  let hh ← minimum_cost_loop2 h1 (alloc.vec.Vec.new Std.I64) start_h
  let i5 := alloc.vec.Vec.len v1
  let start_v ← i5 - cnt_v1
  let vv ← minimum_cost_loop3 v1 (alloc.vec.Vec.new Std.I64) start_v
  let hp := alloc.vec.Vec.len hh
  let vp := alloc.vec.Vec.len vv
  let (hp1, vp1, horizontal_cuts, vertical_cuts, total) ←
    minimum_cost_loop4 hh vv hp vp 0#i64 0#i64 0#i64
  let (horizontal_cuts1, total1) ←
    minimum_cost_loop5 hh hp1 horizontal_cuts vertical_cuts total
  minimum_cost_loop6 vv vp1 horizontal_cuts1 vertical_cuts total1

end Aegis.MinimumCost
