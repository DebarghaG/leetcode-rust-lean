[
  {
    "id": 1,
    "theorem": "AegisSpec.DistanceSum.spec_1",
    "negation": "AegisSpec.DistanceSum.spec_1_neg",
    "main": true,
    "category": "functional",
    "statement": "The function returns a result r such that 0 <= r < M and r ≡ T(m,n,k) (mod M), where T(m,n,k) is the sum over all k-element subsets A of the set of cells { (x,y) | 0 <= x < m, 0 <= y < n } of the sum over all unordered pairs {p,q} of distinct elements of A of (|p.x - q.x| + |p.y - q.y|).",
    "preconditions": "m, n, k are integers such that 1 <= m <= 100000, 1 <= n <= 100000, 2 <= m*n <= 100000, and 2 <= k <= m*n. Let M = 1000000007."
  },
  {
    "id": 2,
    "theorem": "AegisSpec.DistanceSum.spec_2",
    "negation": "AegisSpec.DistanceSum.spec_2_neg",
    "main": false,
    "category": "no_failure",
    "statement": "The function returns a result (i.e., it does not fail, panic, or overflow) for every input satisfying the preconditions.",
    "preconditions": "m, n, k are integers such that 1 <= m <= 100000, 1 <= n <= 100000, 2 <= m*n <= 100000, and 2 <= k <= m*n."
  },
  {
    "id": 3,
    "theorem": "AegisSpec.DistanceSum.spec_3",
    "negation": "AegisSpec.DistanceSum.spec_3_neg",
    "main": false,
    "category": "invariance",
    "statement": "For every valid (m,n,k), if r1 = distance_sum(m,n,k) and r2 = distance_sum(n,m,k), then r1 ≡ r2 (mod 1000000007).",
    "preconditions": "m, n, k are integers such that 1 <= m <= 100000, 1 <= n <= 100000, 2 <= m*n <= 100000, and 2 <= k <= m*n."
  },
  {
    "id": 4,
    "theorem": "AegisSpec.DistanceSum.spec_4",
    "negation": "AegisSpec.DistanceSum.spec_4_neg",
    "main": false,
    "category": "relational",
    "statement": "Let N = m*n and let S(m,n) = sum over all unordered pairs of distinct cells {p,q} in { (x,y) | 0 <= x < m, 0 <= y < n } of (|p.x - q.x| + |p.y - q.y|). Then the returned r satisfies r ≡ C(N-2, k-2) * S(m,n) (mod 1000000007), where C(a,b) denotes the binomial coefficient (number of b-element subsets of an a-element set).",
    "preconditions": "m, n, k are integers such that 1 <= m <= 100000, 1 <= n <= 100000, 2 <= m*n <= 100000, and 2 <= k <= m*n."
  },
  {
    "id": 5,
    "theorem": "AegisSpec.DistanceSum.spec_5",
    "negation": "AegisSpec.DistanceSum.spec_5_neg",
    "main": false,
    "category": "relational",
    "statement": "The returned r satisfies r ≡ C(m*n - 2, k-2) * ( n^2 * (m^3 - m) / 6 + m^2 * (n^3 - n) / 6 ) (mod 1000000007), where the divisions are integer divisions (the numerators are always divisible by 6).",
    "preconditions": "m, n, k are integers such that 1 <= m <= 100000, 1 <= n <= 100000, 2 <= m*n <= 100000, and 2 <= k <= m*n."
  },
