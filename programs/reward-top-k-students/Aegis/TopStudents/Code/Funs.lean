    top_students_loop1 positive_feedback negative_feedback report pos_order
      neg_order n points 0#usize
  let s := alloc.vec.Vec.deref points1
  let order ← build_rank_order s student_id
  top_students_loop2 student_id order (alloc.vec.Vec.new Std.I64) k 0#usize

end Aegis.TopStudents
