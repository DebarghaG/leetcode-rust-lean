  let n := Slice.len tasks
  let v ← minimum_rounds_loop0 tasks n (alloc.vec.Vec.new Std.I64) 0#usize
  if n > 1#usize
  then
    let temp ← minimum_rounds_loop1 n (alloc.vec.Vec.new Std.I64) 0#usize
    let v1 ← minimum_rounds_loop2 n v temp 1#usize
    minimum_rounds_loop3 n v1 0#i64 0#usize
  else minimum_rounds_loop4 n v 0#i64 0#usize

