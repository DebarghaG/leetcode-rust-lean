      let i ← right - lo
      let i1 ← i + 1#i64
      let n ← lift (IScalar.hcast .Usize i1)
      let is_p ← closest_primes_loop4 n (alloc.vec.Vec.new Bool) 0#usize
      let is_p1 ← closest_primes_loop5 right lo small_primes is_p 0#usize
      let plist ←
        closest_primes_loop6 lo n is_p1 (alloc.vec.Vec.new Std.I64) 0#usize
      let i2 := alloc.vec.Vec.len plist
      if i2 < 2#usize
      then
        let ans ← alloc.vec.Vec.push (alloc.vec.Vec.new Std.I64) (-1)#i64
        alloc.vec.Vec.push ans (-1)#i64
      else
        let i3 ← right - lo
        let best_gap ← i3 + 2#i64
        let (best1, best2) ←
          closest_primes_loop7 plist best_gap (-1)#i64 (-1)#i64 1#usize
        let ans ← alloc.vec.Vec.push (alloc.vec.Vec.new Std.I64) best1
        alloc.vec.Vec.push ans best2

end Aegis.ClosestPrimes
