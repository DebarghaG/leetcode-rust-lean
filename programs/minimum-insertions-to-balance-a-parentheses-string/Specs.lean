/-- Whenever the function returns a result r, r = 2 * n.
  Preconditions: s is a byte slice of length n with 1 <= n <= 100000, every character of s is '(', so the number of ')' is R = 0. -/
theorem spec_8 (s : Slice Std.U8) (n : ℕ)
    (hn : 1 ≤ n) (hn_ub : n ≤ 100000) (hlen : s.length = n)
    (hparen : ∀ b ∈ s.val, b = LPAREN) :
