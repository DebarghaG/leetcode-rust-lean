  := do
  let m := Slice.len grid
  let v ← Slice.index_usize grid 0#usize
  let n := alloc.vec.Vec.len v
  let total ← m * n
  let k := Slice.len queries
  let (vals, rows, cols) ←
    max_points_loop0 grid m n (alloc.vec.Vec.new Std.I64) (alloc.vec.Vec.new
      Std.Usize) (alloc.vec.Vec.new Std.Usize) 0#usize
  let cells ← max_points_loop1 total (alloc.vec.Vec.new Std.Usize) 0#usize
  let cells1 ← merge_sort_by_key vals cells
  let qvals ← max_points_loop2 queries k (alloc.vec.Vec.new Std.I64) 0#usize
  let qidx ← max_points_loop3 k (alloc.vec.Vec.new Std.Usize) 0#usize
  let qidx1 ← merge_sort_by_key qvals qidx
  let (parent, size, active) ←
    max_points_loop4 total (alloc.vec.Vec.new Std.Usize) (alloc.vec.Vec.new
      Std.I64) (alloc.vec.Vec.new Bool) 0#usize
  let ans ← max_points_loop5 k (alloc.vec.Vec.new Std.I64) 0#usize
  max_points_loop6 queries m n total k vals rows cols cells1 qidx1 parent size
    active ans 0#usize 0#usize

